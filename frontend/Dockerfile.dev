# Imagem só para desenvolvimento (docker-compose). O deploy do frontend é
# estático na Vercel — ver vercel.json e o README.
FROM node:22-alpine
WORKDIR /app

# Instala as dependências numa camada própria, aproveitando o cache enquanto
# package.json e package-lock.json não mudarem.
COPY package*.json ./
RUN npm ci

COPY . ./

EXPOSE 5173
CMD ["npm", "run", "dev"]
